<!DOCTYPE html>
<html lang="en-us">
  <head>
    {% include "./head.njk" %}
  </head>
  <body>
    {% include "./header.njk" %}

    <!-- Main section-->
    <div id="main-section" class="container px-4">
      <main class="container px-4">
        <div class="row gx-4 justify-content-center">
          <div class="col-lg-10">

            {% block content %}

                {% if dropdownPages %}
                <nav class="second-level" aria-label="{{dropdownName}}">
                  {% for page in dropdownPages %}
                    {% if loop.first %}
                    <a href="{{page.filename}}">{{page.link}}</a>
                    {% else %}
                      {% if page.filename %}
                       | <a href="{{page.filename}}">{{page.link}}</a>
                      {% endif %}
                    {% endif %}
                  {% endfor %}
                </nav>
                {% endif %}

                {% if title != 'Home' %}
                  <h1>{{title}}</h1>
                {% else %}
                  <h1 aria-label="Open Web Accessibility Services">
                    <svg role="none" viewBox="0 0 220 55" xmlns="http://www.w3.org/2000/svg">
                      <g class="brand">
                        <g class="open">
                          <rect x="0" y="5" width="26" height="52"></rect>
                          <text x="-47" y="18" transform="rotate(-90)">Open</text>
                        </g>
                        <g class="web">
                          <rect x="25" y="5" width="210" height="25"></rect>
                          <text x="28" y="24">Web</text>
                        </g>
                        <g class="a11y">
                          <rect x="25" y="30" width="210" height="27"></rect>
                          <text x="28" y="50">Accessibility Services</text>
                        </g>
                      </g>
                    </svg>
                  </h1>
                  <div class="lead">
                    Jon Gunderson is committed to helping people learn and use W3C web accessibility standards to improve the experience of people with disabilities using the web.
                  </div>
                {% endif %}

                {% include './' + content %}

            {% endblock %}
          </div>
        </div>
      </main>
    </div>
    {% include "./footer.njk" %}
    {% include "./scripts.njk" %}

  </body>
</html>
